  <div class="gallery">
    <div class="gallery-item wide" onclick="openLB(galleryImgs,0)"><img src="data:image/jpeg;base64," alt="Kidney Stone Infographic"><div class="gallery-overlay"><span class="gallery-label">Kidney Stone Awareness — Source Says</span></div></div>
    <div class="gallery-item wide" onclick="openLB(galleryImgs,1)"><img src="data:image/jpeg;base64," alt="Kidney Care Campaign"><div class="gallery-overlay"><span class="gallery-label">Why Let Kidneys Carry The Burden</span></div></div>
