<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kalyani Kidney Care Centre — Sudharsan Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{--ink:#1e2433;--ink-mid:#3a3d4a;--ink-soft:#7c8090;--bg:#f4f6f9;--bg2:#eef0f5;--white:#fff;--blue:#2563eb;--accent:#1d4ed8}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--ink)}
.topnav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(255,255,255,.95);backdrop-filter:blur(12px);border-bottom:1px solid rgba(37,99,235,.1);padding:0 5vw;height:64px;display:flex;align-items:center;justify-content:space-between}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:700;color:var(--ink);text-decoration:none}
.nav-logo span{color:var(--blue)}
.back-btn{display:inline-flex;align-items:center;gap:8px;background:var(--blue);color:#fff;padding:9px 20px;border-radius:8px;text-decoration:none;font-size:.82rem;font-weight:600;transition:all .2s}
.back-btn:hover{background:var(--accent);transform:translateY(-1px)}
.proj-hero{margin-top:64px;padding:70px 5vw 60px;background:linear-gradient(135deg,#e8ecf4,#dde4f0)}
.proj-hero-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
.proj-logo{width:120px;height:120px;border-radius:20px;object-fit:contain;background:#fff;padding:16px;box-shadow:0 8px 30px rgba(37,99,235,.12);margin-bottom:1.5rem}
.proj-cat{display:inline-flex;align-items:center;gap:8px;font-size:.72rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--blue);margin-bottom:.8rem}
.proj-cat::before{content:'';width:24px;height:2px;background:var(--blue)}
.proj-title{font-family:'Cormorant Garamond',serif;font-size:clamp(2.2rem,5vw,3.8rem);font-weight:700;line-height:1.1;color:var(--ink);margin-bottom:1rem}
.proj-desc{font-size:.97rem;color:var(--ink-mid);line-height:1.8;margin-bottom:2rem}
.proj-tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:2rem}
.tag{background:rgba(37,99,235,.08);color:var(--blue);border-radius:20px;padding:5px 14px;font-size:.75rem;font-weight:500}
.proj-stats{display:flex;gap:2.5rem}
.stat-num{font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:700;color:var(--ink);line-height:1}
.stat-lbl{font-size:.72rem;color:var(--ink-soft);letter-spacing:.06em;text-transform:uppercase;margin-top:4px}
.hero-img{width:100%;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.12);object-fit:cover}
@media(max-width:900px){.proj-hero-inner{grid-template-columns:1fr}}
.section{padding:70px 5vw;max-width:1100px;margin:0 auto}
.section-full{padding:70px 5vw;background:var(--white)}
.section-full .section{padding:0;background:none}
.s-tag{display:inline-flex;align-items:center;gap:10px;font-size:.72rem;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--blue);margin-bottom:.8rem}
.s-tag::before{content:'';width:24px;height:2px;background:var(--blue)}
.s-title{font-family:'Cormorant Garamond',serif;font-size:2rem;font-weight:700;color:var(--ink);margin-bottom:2rem}
.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;margin-top:1rem}
.gallery-item{position:relative;border-radius:12px;overflow:hidden;cursor:pointer;aspect-ratio:1;background:var(--bg2)}
.gallery-item img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}
.gallery-item:hover img{transform:scale(1.06)}
.gallery-item.wide{grid-column:span 2}
.gallery-overlay{position:absolute;inset:0;background:linear-gradient(0deg,rgba(30,36,51,.7),transparent);opacity:0;transition:opacity .3s;display:flex;align-items:flex-end;padding:1rem}
.gallery-item:hover .gallery-overlay{opacity:1}
.gallery-label{color:#fff;font-size:.82rem;font-weight:500}
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:999;display:none;align-items:center;justify-content:center;padding:2rem}
.lightbox.open{display:flex}
.lightbox img{max-width:90vw;max-height:85vh;object-fit:contain;border-radius:8px}
.lb-close{position:fixed;top:20px;right:24px;color:#fff;font-size:2rem;cursor:pointer;background:none;border:none;line-height:1;padding:4px 12px;border-radius:8px;transition:background .2s}
.lb-close:hover{background:rgba(255,255,255,.1)}
.lb-prev,.lb-next{position:fixed;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.1);color:#fff;border:none;font-size:1.8rem;cursor:pointer;padding:12px 18px;border-radius:8px;transition:background .2s}
.lb-prev{left:16px}.lb-next{right:16px}
.lb-prev:hover,.lb-next:hover{background:rgba(255,255,255,.2)}
.lb-counter{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.6);font-size:.82rem}
.timeline{position:relative;padding-left:2rem;margin-top:1rem}
.timeline::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--blue),rgba(37,99,235,.1))}
.tl-item{position:relative;padding:0 0 2.5rem 2rem}
.tl-item:last-child{padding-bottom:0}
.tl-dot{position:absolute;left:-2rem;top:4px;width:14px;height:14px;border-radius:50%;background:var(--blue);border:3px solid var(--bg);box-shadow:0 0 0 2px var(--blue);transform:translateX(50%)}
.tl-date{font-size:.75rem;font-weight:600;color:var(--blue);letter-spacing:.08em;text-transform:uppercase;margin-bottom:.4rem}
.tl-card{background:var(--white);border-radius:14px;padding:1.4rem 1.6rem;border-left:3px solid var(--blue);box-shadow:0 2px 12px rgba(0,0,0,.05)}
.tl-role{font-size:1rem;font-weight:600;color:var(--ink);margin-bottom:.3rem}
.tl-org{font-size:.85rem;color:var(--blue);font-weight:500;margin-bottom:.6rem}
.tl-body{font-size:.88rem;color:var(--ink-mid);line-height:1.7}
.tl-badges{display:flex;flex-wrap:wrap;gap:6px;margin-top:.8rem}
.tl-badge{background:rgba(37,99,235,.08);color:var(--blue);border-radius:12px;padding:3px 10px;font-size:.72rem;font-weight:500}
.srv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;margin-top:1rem}
.srv-card{background:var(--white);border-radius:14px;padding:1.5rem;border:1px solid rgba(37,99,235,.08);transition:all .2s}
.srv-card:hover{transform:translateY(-4px);box-shadow:0 8px 24px rgba(37,99,235,.1);border-color:rgba(37,99,235,.2)}
.srv-icon{font-size:1.8rem;margin-bottom:.8rem;display:block}
.srv-name{font-size:.92rem;font-weight:600;color:var(--ink);margin-bottom:.4rem}
.srv-desc{font-size:.82rem;color:var(--ink-soft);line-height:1.6}
.results-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;margin-top:1rem}
.result-card{background:linear-gradient(135deg,var(--blue),var(--accent));border-radius:14px;padding:1.5rem;text-align:center;color:#fff}
.result-num{font-family:'Cormorant Garamond',serif;font-size:2.5rem;font-weight:700;line-height:1;margin-bottom:.3rem}
.result-lbl{font-size:.78rem;opacity:.8;letter-spacing:.04em}
.proj-footer{background:var(--ink);color:rgba(255,255,255,.4);text-align:center;padding:1.5rem;font-size:.8rem;margin-top:4rem}
.proj-footer span{color:#60a5fa}
.rv{opacity:0;transform:translateY(20px);transition:opacity .5s ease,transform .5s ease}
.rv.on{opacity:1;transform:none}
.d1{transition-delay:.1s}.d2{transition-delay:.2s}.d3{transition-delay:.3s}
</style>
</head><body>
